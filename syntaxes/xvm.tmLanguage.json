{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Silex",
	"scopeName": "source.xvm",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#bytes_literal"
		},
		{
			"include": "#string_literal"
		},
		{
			"include": "#function_declaration"
		},
		{
			"include": "#enum_declaration"
		},
		{
			"include": "#enum_variant_access"
		},
		{
			"include": "#struct_declaration"
		},
		{
			"include": "#closure_type"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#storage_types"
		},
		{
			"include": "#type_names"
		},
		{
			"include": "#builtin_functions"
		},
		{
			"include": "#all_functions"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#brackets"
		},
		{
			"include": "#delimiters"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"begin": "//",
					"end": "(?:\\n|$)",
					"name": "comment.line.double-slash.xvm"
				},
				{
					"begin": "/\\*",
					"end": "\\*/",
					"name": "comment.block.xvm"
				}
			]
		},
		"bytes_literal": {
			"patterns": [
				{
					"begin": "\\bb\"",
					"end": "\"",
					"name": "string.quoted.other.bytes.xvm",
					"patterns": [
						{
							"match": "\\\\.",
							"name": "constant.character.escape.xvm"
						}
					]
				}
			]
		},
		"string_literal": {
			"patterns": [
				{
					"begin": "\"",
					"end": "\"",
					"name": "string.quoted.double.xvm",
					"patterns": [
						{
							"match": "\\\\.",
							"name": "constant.character.escape.xvm"
						}
					]
				}
			]
		},
		"function_declaration": {
			"patterns": [
				{
					"match": "\\b(pub)\\b",
					"name": "storage.modifier.xvm"
				},
				{
					"match": "\\b(fn|entry|hook)\\b\\s*(?:\\(\\s*(\\w+)\\s+([^)]*?)\\s*\\)\\s*)?(\\w+)",
					"captures": {
						"1": {
							"name": "keyword.declaration.function.xvm"
						},
						"2": {
							"name": "variable.parameter.receiver.xvm"
						},
						"3": {
							"patterns": [
								{
									"include": "#storage_types"
								},
								{
									"include": "#type_names"
								}
							]
						},
						"4": {
							"name": "entity.name.function.xvm"
						}
					}
				}
			]
		},
		"enum_declaration": {
			"patterns": [
				{
					"begin": "\\b(enum)\\b\\s*(\\w+)(\\s*<[^>{}]*>)?\\s*(\\{)",
					"beginCaptures": {
						"1": {
							"name": "storage.type.enum.xvm"
						},
						"2": {
							"name": "entity.name.type.enum.xvm"
						},
						"3": {
							"patterns": [
								{
									"include": "#storage_types"
								},
								{
									"include": "#type_names"
								},
								{
									"include": "#delimiters"
								}
							]
						},
						"4": {
							"name": "punctuation.definition.begin.bracket.curly.xvm"
						}
					},
					"end": "\\}",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.end.bracket.curly.xvm"
						}
					},
					"patterns": [
						{
							"include": "#enum_variant"
						},
						{
							"include": "$self"
						}
					]
				},
				{
					"match": "\\b(enum)\\b\\s*(\\w+)",
					"captures": {
						"1": {
							"name": "storage.type.enum.xvm"
						},
						"2": {
							"name": "entity.name.type.enum.xvm"
						}
					}
				}
			]
		},
		"enum_variant": {
			"patterns": [
				{
					"match": "\\b([A-Za-z_]\\w*)\\b(?=\\s*(?:\\(|\\{|,|\\}|//|$))",
					"captures": {
						"1": {
							"name": "variable.other.enummember.xvm"
						}
					}
				}
			]
		},
		"enum_variant_access": {
			"patterns": [
				{
					"match": "\\b([A-Z][A-Za-z0-9_]*)(\\s*<[^<>{}]*>)?\\s*(::)\\s*([A-Z][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"patterns": [
								{
									"include": "#type_names"
								}
							]
						},
						"2": {
							"patterns": [
								{
									"include": "#storage_types"
								},
								{
									"include": "#type_names"
								},
								{
									"include": "#delimiters"
								}
							]
						},
						"3": {
							"name": "punctuation.separator.namespace.xvm"
						},
						"4": {
							"name": "variable.other.enummember.xvm"
						}
					}
				}
			]
		},
		"struct_declaration": {
			"match": "\\b(struct)\\b\\s*(\\w+)",
			"captures": {
				"1": {
					"name": "storage.type.struct.xvm"
				},
				"2": {
					"name": "entity.name.type.struct.xvm"
				}
			}
		},
		"closure_type": {
			"match": "\\b(closure)\\b",
			"name": "storage.type.closure.xvm"
		},
		"constants": {
			"patterns": [
				{
					"match": "\\b(true|false)\\b",
					"name": "constant.language.boolean.xvm"
				},
				{
					"match": "\\bnull\\b",
					"name": "constant.language.null.xvm"
				},
				{
					"match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|[0-9][0-9_]*)(?:u8|u16|u32|u64|u128|u256)?\\b",
					"name": "constant.numeric.xvm"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"match": "\\b(if|else|for|foreach|while|in|break|continue|return|match)\\b",
					"name": "keyword.control.xvm"
				},
				{
					"match": "\\bas\\b",
					"name": "keyword.operator.word.cast.xvm"
				},
				{
					"match": "\\b(let|const)\\b",
					"name": "keyword.declaration.variable.xvm"
				},
				{
					"match": "\\bimport\\b",
					"name": "keyword.other.import.xvm"
				},
				{
					"match": "\\bfrom\\b",
					"name": "keyword.other.import.xvm"
				}
			]
		},
		"storage_types": {
			"patterns": [
				{
					"match": "\\b(u8|u16|u32|u64|u128|u256)\\b",
					"name": "storage.type.numeric.xvm"
				},
				{
					"match": "\\bbool\\b",
					"name": "storage.type.boolean.xvm"
				},
				{
					"match": "\\bstring\\b",
					"name": "storage.type.string.xvm"
				},
				{
					"match": "\\bbytes\\b",
					"name": "storage.type.bytes.xvm"
				},
				{
					"match": "\\b(optional|range|map)\\b",
					"name": "storage.type.generic.xvm"
				},
				{
					"match": "\\bany\\b",
					"name": "storage.type.any.xvm"
				}
			]
		},
		"type_names": {
			"patterns": [
				{
					"match": "\\b([A-Z][A-Za-z0-9_]*)\\b",
					"name": "entity.name.type.xvm"
				}
			]
		},
		"builtin_functions": {
			"patterns": [
				{
					"match": "\\b(println|print|assert|panic)\\b",
					"name": "support.function.builtin.xvm"
				}
			]
		},
		"all_functions": {
			"patterns": [
				{
					"match": "\\b(\\w+)\\s*(?=\\()",
					"captures": {
						"1": {
							"name": "entity.name.function.xvm"
						}
					}
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"match": "->",
					"name": "keyword.operator.return-type.xvm"
				},
				{
					"match": "=>",
					"name": "keyword.operator.fat-arrow.xvm"
				},
				{
					"match": "<<=|>>=",
					"name": "keyword.operator.assignment.bitwise.xvm"
				},
				{
					"match": "\\*\\*=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=",
					"name": "keyword.operator.assignment.xvm"
				},
				{
					"match": "<<|>>",
					"name": "keyword.operator.bitwise.shift.xvm"
				},
				{
					"match": "==|!=|<=|>=|<|>",
					"name": "keyword.operator.comparison.xvm"
				},
				{
					"match": "&&|\\|\\||!",
					"name": "keyword.operator.logical.xvm"
				},
				{
					"match": "=",
					"name": "keyword.operator.assignment.xvm"
				},
				{
					"match": "\\*\\*|\\*|\\+|/|%|-",
					"name": "keyword.operator.arithmetic.xvm"
				},
				{
					"match": "&|\\||\\^",
					"name": "keyword.operator.bitwise.xvm"
				},
				{
					"match": "\\.\\.",
					"name": "keyword.operator.range.xvm"
				},
				{
					"match": "\\?",
					"name": "keyword.operator.ternary.xvm"
				}
			]
		},
		"brackets": {
			"patterns": [
				{
					"begin": "\\{",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.begin.bracket.curly.xvm"
						}
					},
					"end": "\\}",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.end.bracket.curly.xvm"
						}
					},
					"patterns": [
						{
							"include": "$self"
						}
					]
				},
				{
					"begin": "\\(",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.begin.bracket.round.xvm"
						}
					},
					"end": "\\)",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.end.bracket.round.xvm"
						}
					},
					"patterns": [
						{
							"include": "$self"
						}
					]
				},
				{
					"begin": "\\[",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.begin.bracket.square.xvm"
						}
					},
					"end": "\\]",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.end.bracket.square.xvm"
						}
					},
					"patterns": [
						{
							"include": "$self"
						}
					]
				}
			]
		},
		"delimiters": {
			"patterns": [
				{
					"match": "::",
					"name": "punctuation.separator.namespace.xvm"
				},
				{
					"match": ",",
					"name": "punctuation.separator.comma.xvm"
				},
				{
					"match": "\\.(?!\\.)",
					"name": "punctuation.separator.period.xvm"
				},
				{
					"match": ":",
					"name": "punctuation.separator.type.xvm"
				},
				{
					"match": ";",
					"name": "punctuation.terminator.statement.xvm"
				}
			]
		}
	}
}
